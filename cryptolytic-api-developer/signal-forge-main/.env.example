# Copy to .env and adjust for your environment.

# --- Indicator API (compute endpoint, API keys, usage) ----------------------
# The technical-indicator engine. Locally this is the Python microservice
# (default port 8000); in production it can be the Go gateway itself.
VITE_API_BASE_URL=http://localhost:8000

# --- Shared auth backend (Crypto Pulse Hub Go API) --------------------------
# Login/Register hit this origin, which stores accounts in the SAME database
# as the main platform — one email/password works across both products.
# Local Go backend:  http://localhost:8080
# Production:        https://cryptolytic-api.onrender.com
# The origin must be listed in the backend's CORS_ORIGINS for browser requests
# (defaults already include http://localhost:5173 and http://localhost:3001).
VITE_AUTH_API_BASE_URL=http://localhost:8080
