[TEMPLATE]
# Copy to .env and adjust for your environment.

# --- Indicator API (compute endpoint, API keys, usage) ----------------------
# The technical-indicator engine. Locally this is the Python microservice
# (default port 8000); in production it can be the Go gateway itself.
#
# Local dev:    http://localhost:8000
# Production:   https://cryptolytic-developer.onrender.com  ← same-origin;
#               /api/** is proxied to the Go backend by nitro.config.ts
#               (target: NITRO_API_PROXY, default https://cryptolytic-api.onrender.com),
#               so the browser never calls the backend directly.
VITE_API_BASE_URL=http://localhost:8000

# --- Shared auth backend (Crypto Pulse Hub Go API) --------------------------
# Login/Register hit this origin, which stores accounts in the SAME database
# as the main platform — one email/password works across both products.
# When unset it falls back to VITE_API_BASE_URL.
#
# Local dev:    http://localhost:8080
# Production:   https://cryptolytic-developer.onrender.com (same-origin proxy)
VITE_AUTH_API_BASE_URL=http://localhost:8080
